/* Layout for the login screen. How its views look is the skin's job
   (Skins/Phosphor/Phosphor.uss); this sheet only places them. Anything visual
   here uses the skin's tokens, so a skin still recolours it. */

.login-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.hidden {
    display: none;
}

.panel {
    width: 320px;
    flex-grow: 0;
    flex-shrink: 0;
    padding: 12px;
}

.character-panel {
    height: 400px;
}

.login-content,
.character-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.title {
    flex-shrink: 0;
    margin-bottom: 12px;
}

.title .ao-text-view__label {
    -unity-text-align: middle-center;
}

.field-label {
    margin-top: 8px;
    margin-bottom: 4px;
    color: var(--ao-fg-dim);
}

.field-label .ao-text-view__label {
    --ao-text-transform: uppercase;
}

.browse-button {
    align-self: flex-end;
    margin-top: 4px;
}

.status-text {
    flex-shrink: 0;
    min-height: 32px;
    margin-top: 8px;
    color: var(--ao-bad);
}

.status-text .ao-text-view__label {
    -unity-text-align: upper-center;
}

.connect-button,
.back-button {
    margin-top: 8px;
}

/* The list is what gives way when the panel runs short; the title and the
   status line above and below it keep their height. */
.character-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 4px;
    background-color: var(--ao-bg-1);
    border-width: 1px;
    border-color: var(--ao-line);
}

.character-list {
    padding: 4px;
}

/* A name is a name, not a command: left-aligned and in its own case. */
.character-button {
    align-items: flex-start;
    margin-bottom: 4px;
}

.character-button .ao-button__label {
    --ao-text-transform: none;
}
