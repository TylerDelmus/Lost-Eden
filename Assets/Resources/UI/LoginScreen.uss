.login-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    color: rgb(255, 255, 255);
}

.hidden {
    display: none;
}

.panel {
    width: 400px;
    height: 400px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    padding: 20px;
    background-color: rgba(20, 26, 36, 0.92);
    border-radius: 4px;
    overflow: hidden;
    color: rgb(255, 255, 255);
}

.login-panel {
    padding-bottom: 15px;
}

.aopath-panel {
    padding-bottom: 15px;
}

.character-panel {
    padding-bottom: 15px;
}

.browse-button {
    flex-grow: 0;
    flex-shrink: 0;
    height: 36px;
    margin-top: 4px;
    margin-bottom: 6px;
    background-color: rgb(46, 56, 77);
    border-width: 0;
    border-radius: 2px;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: normal;
}

.browse-button:hover {
    background-color: rgb(56, 68, 92);
}

.login-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.title {
    font-size: 32px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
    height: 44px;
}

.field-label {
    font-size: 16px;
    color: rgb(255, 255, 255);
    height: 20px;
    margin-top: 4px;
}

.text-field {
    height: 36px;
    margin-bottom: 6px;
    background-color: rgb(38, 43, 56);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
}

.text-field .unity-base-text-field__input {
    background-color: rgb(38, 43, 56);
    border-width: 0;
    color: rgb(255, 255, 255);
    padding-left: 10px;
    padding-right: 10px;
}

.text-field .unity-text-element {
    color: rgb(255, 255, 255);
}

.text-field > .unity-text-field__input {
    background-color: rgb(38, 43, 56);
    border-width: 0;
    color: rgb(255, 255, 255);
    padding-left: 10px;
    padding-right: 10px;
}

.dropdown-field {
    height: 36px;
    margin-bottom: 6px;
    background-color: rgb(38, 43, 56);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
}

.dropdown-field .unity-base-popup-field__text {
    color: rgb(255, 255, 255);
}

.dropdown-field > .unity-base-field__input {
    background-color: rgb(38, 43, 56);
    border-width: 0;
    color: rgb(255, 255, 255);
}

.flex-spacer {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 12px;
}

.status-text {
    font-size: 16px;
    -unity-text-align: upper-center;
    color: rgb(255, 191, 191);
    min-height: 36px;
    margin-bottom: 8px;
    white-space: normal;
}

.connect-button {
    flex-grow: 0;
    flex-shrink: 0;
    height: 40px;
    margin-top: 8px;
    background-color: rgb(51, 115, 191);
    border-width: 0;
    border-radius: 2px;
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: normal;
}

.connect-button:hover {
    background-color: rgb(61, 130, 210);
}

.connect-button:disabled,
.connect-button.unity-disabled {
    background-color: rgb(40, 70, 110);
    color: rgba(255, 255, 255, 0.5);
    opacity: 1;
}

.connect-button:disabled:hover,
.connect-button.unity-disabled:hover {
    background-color: rgb(40, 70, 110);
}

.character-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.back-button {
    flex-grow: 0;
    flex-shrink: 0;
    height: 40px;
    margin-top: 8px;
    background-color: rgb(46, 56, 77);
    border-width: 0;
    border-radius: 2px;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: normal;
}

.back-button:hover {
    background-color: rgb(56, 68, 92);
}

.character-scroll {
    flex-grow: 1;
    margin-top: 12px;
    margin-bottom: 12px;
    background-color: rgba(13, 15, 20, 0.8);
    border-width: 0;
}

.character-list {
    flex-direction: column;
    padding: 8px;
}

.character-button {
    height: 36px;
    margin-bottom: 6px;
    background-color: rgb(46, 56, 77);
    border-width: 0;
    border-radius: 2px;
    -unity-text-align: middle-left;
    padding-left: 12px;
    padding-right: 12px;
    color: rgb(255, 255, 255);
    font-size: 18px;
}

.character-button:hover {
    background-color: rgb(56, 68, 92);
}

.unity-disabled {
    opacity: 1;
}

.text-field.unity-disabled,
.dropdown-field.unity-disabled,
.connect-button.unity-disabled {
    opacity: 1;
}
