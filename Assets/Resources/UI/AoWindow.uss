.ao-window-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.ao-window-frame {
    width: 360px;
    min-height: 280px;
    padding: 12px;
    flex-direction: column;
    /* Visible even when UVGA has not resolved yet in UI Builder */
    background-color: rgb(48, 52, 64);
    border-width: 2px;
    border-color: rgb(120, 110, 80);
    border-radius: 4px;
}

.ao-window-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 28px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.ao-window-title {
    font-size: 16px;
    color: rgb(240, 230, 200);
    -unity-font-style: bold;
}

.ao-window-close {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
}

.ao-window-body {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
}
