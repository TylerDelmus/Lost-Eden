/* ============================================================================
   Phosphor — Lost Eden's default skin.

   The same design language as the PHOSPHOR kit in malis-ao-toolkit-web: flat
   near-black surfaces, 1px lines, amber for anything you can act on, cyan
   for numbers, and stock AO's own 1-bit Verdana for every glyph.

   A skin is a stylesheet over the Ao* views. It decides how each view looks.
   It does not decide what the views are or how they behave. That lives in
   the C# (Assets/Scripts/UI/Ao), and a skin cannot change it.

   ── What a skin can reach ──────────────────────────────────────────────

   Every view carries `ao-view` plus its own block class, named after the
   stock class it ports (AoButton -> .ao-button, AoTextView -> .ao-text-view).
   Its parts are `block__part` and its states `block--state`:

     .ao-button            __label   --pressed  --on (toggled)   :hover :disabled
     .ao-text-button       __label   --pressed  --on
     .ao-text-view         __label
     .ao-border-view                                       the framed box
     .ao-scroll-view       __scroller
     .ao-text-input-view   __field
     .ao-combo-box         __field  __toggle  __popup  __entry   --open
     .ao-dropdown-menu     __button  __label  __caret  __popup  __entry  __entry--selected  --open
     .ao-multi-list-view   __header  __body  __slot  __empty-slot  --grid  --list
     .ao-column-header-view  __label  __caret  --sorted  --descending
     .ao-multi-list-view-item  __row  __cell  __grid  --grid  --selected
     .ao-dock-window       __header  __tabs  __tab  __tab--selected  __accessory  __close  __body
     .ao-dock-drag-image                                   a dragged tab's label
     .ao-dockable-view
     .ao-item-container-view
     .ao-item-slot-view    --empty
     .ao-item-icon-view    __stack
     .ao-caret             --up         (drawn in its `color`)
     .ao-font--<key>       stock's font keys: small, normal, large, huge, cc17

   UI Toolkit has no text-transform. Set `--ao-text-transform: uppercase`
   on a __label instead and the view applies it.

   ── Pixel-exact text ───────────────────────────────────────────────────

   The fonts are bitmaps. Each one is exact only at its own cell height,
   through the standard text generator, on a whole-number panel scale.
   So a font is always set as a triple: family, size, generator. See
   Docs/UI.md §8a.
   ========================================================================= */

/* ─── Tokens ───────────────────────────────────────────────────────────── */

:root {
    /* Surfaces, near-black through to raised. The background (bg-1), the
       button (bg-3), the outline and the text are sampled from stock's own
       button; bg-2 and bg-4 are ours, a step either side of the button.
       Every surface is 97% opaque, so the world shows through the UI. Only
       surfaces: text and lines are always solid, so never colour either with
       a bg token. */
    --ao-bg-0: rgba(6, 8, 11, 0.97);
    --ao-bg-1: rgba(19, 15, 13, 0.97);
    --ao-bg-2: rgba(26, 28, 26, 0.97);
    --ao-bg-3: rgba(33, 41, 40, 0.97);
    --ao-bg-4: rgba(43, 53, 52, 0.97);

    --ao-line-lo: #212928;
    --ao-line: #317b84;
    /* Hover lifts a line halfway to the text colour; focus takes it all the
       way, so the field being typed into is the brightest edge on screen. */
    --ao-line-hi: #58b2bb;
    --ao-line-focus: #80e9f3;

    /* Text: stock's GUIColors.xml "Default" and "Hover". */
    --ao-fg: #80e9f3;
    --ao-fg-hi: #a5ffdb;
    --ao-fg-dim: #7c8b9c;
    --ao-fg-mute: #4d5a6a;
    /* What the player types. */
    --ao-fg-input: #ffffff;

    /* Amber drives interaction, cyan marks data. */
    --ao-accent: #ffb454;
    --ao-accent-lo: rgba(74, 55, 32, 0.97);
    --ao-info: #56d4e8;
    --ao-info-lo: #17383f;
    --ao-good: #8ce99a;
    --ao-warn: #ffd43b;
    --ao-bad: #ff6b6b;

    --ao-window: rgba(19, 15, 13, 0.97);
    --ao-panel: rgba(19, 15, 13, 0.97);
    --ao-selection: rgba(255, 180, 84, 0.35);
}

/* ─── Type ─────────────────────────────────────────────────────────────── */

/* The combo box's open list is listed too: while open it sits at the top of
   the panel, outside every view, so it would not inherit a view's font. */
.ao-view,
.ao-combo-box__popup {
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Verdana/verdana-13.pixelfont");
    font-size: 13px;
    -unity-text-generator: standard;
    -unity-font-style: normal;
}

/* Stock font keys. Which face each key maps to is this skin's choice; stock's
   own mapping has not been recovered. */
.ao-view.ao-font--small {
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Verdana/verdana-12.pixelfont");
    font-size: 12px;
}

.ao-view.ao-font--normal {
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Verdana/verdana-13.pixelfont");
    font-size: 13px;
}

.ao-view.ao-font--cc17 {
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Verdana/verdana-14.pixelfont");
    font-size: 14px;
}

.ao-view.ao-font--large {
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Verdana/verdana-16.pixelfont");
    font-size: 16px;
}

.ao-view.ao-font--huge {
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Verdana/verdana-bold-20.pixelfont");
    font-size: 20px;
}

/* Every text element under a view starts from nothing: the default theme's
   label padding would put glyphs on half pixels once centred. */
.ao-view .unity-label {
    padding: 0;
    margin: 0;
}

/* ─── Text ─────────────────────────────────────────────────────────────── */

.ao-text-view {
    color: var(--ao-fg);
}

/* ─── Border view: the framed box ───────────────────────────────────────── */

.ao-border-view {
    background-color: var(--ao-panel);
    border-width: 1px;
    border-color: var(--ao-line);
}

/* ─── Buttons ──────────────────────────────────────────────────────────── */

/* The button draws its own frame, because UI Toolkit has no cut corner:
     --ao-button-fill     the inside
     --ao-button-line     the outline
     --ao-button-cut      rows the top-right diagonal steps down; 0 is square
   and border-width gives the outline's thickness per side (it also insets the
   label). background-color and border-color stay clear, or UI Toolkit would
   paint a square box under the cut. */
.ao-button {
    /* Views flow as a column (stock's default layout), so the label is
       centred across by align-items and down by justify-content. */
    align-items: center;
    justify-content: center;
    height: 20px;
    padding: 0 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px 2px;
    border-color: rgba(0, 0, 0, 0);
    --ao-button-fill: var(--ao-bg-3);
    --ao-button-line: var(--ao-line);
    --ao-button-cut: 6;
    color: var(--ao-fg);
}

.ao-button__label {
    -unity-text-align: middle-center;
}

.ao-button:hover {
    --ao-button-fill: var(--ao-bg-4);
    --ao-button-line: var(--ao-line-hi);
    color: var(--ao-fg-hi);
}

.ao-button.ao-button--pressed {
    --ao-button-fill: var(--ao-bg-2);
}

.ao-button.ao-button--on {
    --ao-button-fill: var(--ao-accent-lo);
    --ao-button-line: var(--ao-accent);
    color: var(--ao-accent);
}

.ao-button:disabled {
    --ao-button-fill: var(--ao-bg-3);
    --ao-button-line: var(--ao-line);
    color: var(--ao-fg-mute);
    opacity: 1;
}

.ao-text-button {
    color: var(--ao-fg-dim);
}

.ao-text-button:hover {
    color: var(--ao-fg-hi);
}

.ao-text-button.ao-text-button--pressed,
.ao-text-button.ao-text-button--on {
    color: var(--ao-accent);
}

/* ─── Text input ───────────────────────────────────────────────────────── */

.ao-text-input-view__field,
.ao-combo-box__field {
    margin: 0;
    flex-grow: 1;
}

.ao-text-input-view__field > .unity-base-text-field__input,
.ao-combo-box__field > .unity-base-text-field__input {
    height: 20px;
    margin: 0;
    padding: 0 4px;
    background-color: var(--ao-bg-0);
    border-width: 1px;
    border-radius: 0;
    border-color: var(--ao-line);
    color: var(--ao-fg-input);
    --unity-cursor-color: var(--ao-accent);
    --unity-selection-color: var(--ao-selection);
}

/* The default runtime theme has its own hover and focus rules for this
   border, more specific than a single class plus a pseudo-class: with the
   plain `.ao-text-input-view__field:focus` selector its blue (#006aa6) won.
   The class pair and :enabled are here to outrank it. */
.ao-text-input-view__field.unity-base-text-field:hover:enabled > .unity-base-text-field__input,
.ao-combo-box__field.unity-base-text-field:hover:enabled > .unity-base-text-field__input {
    border-color: var(--ao-line-hi);
}

.ao-text-input-view__field.unity-base-text-field:focus:enabled > .unity-base-text-field__input,
.ao-combo-box__field.unity-base-text-field:focus:enabled > .unity-base-text-field__input {
    border-color: var(--ao-line-focus);
}

.ao-text-input-view__field > .unity-base-field__label {
    min-width: 0;
    padding: 0;
    margin: 0 8px 0 0;
    color: var(--ao-fg-dim);
    -unity-text-align: middle-left;
}

/* ─── Combo box ────────────────────────────────────────────────────────── */

/* The toggle shares the field's frame: no left edge, so the two read as one
   control. */
.ao-combo-box__toggle {
    width: 20px;
    height: 20px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--ao-bg-3);
    border-width: 1px 1px 1px 0;
    border-radius: 0;
    border-color: var(--ao-line);
    color: var(--ao-fg-mute);
}

.ao-combo-box__toggle:hover {
    background-color: var(--ao-bg-4);
    color: var(--ao-fg);
}

.ao-combo-box.ao-combo-box--open > .ao-combo-box__toggle {
    color: var(--ao-accent);
}

.ao-combo-box__popup {
    margin-top: -1px;
    background-color: var(--ao-bg-2);
    border-width: 1px;
    border-color: var(--ao-line-hi);
}

.ao-combo-box__entry {
    height: 20px;
    margin: 0;
    padding: 0 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: var(--ao-fg);
    -unity-text-align: middle-left;
}

.ao-combo-box__entry:hover {
    background-color: var(--ao-bg-4);
    color: var(--ao-fg-hi);
}

/* ─── Dropdown menu ────────────────────────────────────────────────────── */

/* A compact button: the picked choice and a caret. Its list floats at the
   top of the panel while open, so it carries its own font. */
.ao-dropdown-menu__button {
    height: 18px;
    margin: 0;
    padding: 0 4px 0 6px;
    background-color: var(--ao-bg-3);
    border-width: 1px;
    border-radius: 0;
    border-color: var(--ao-line);
    color: var(--ao-fg);
}

.ao-dropdown-menu__button:hover {
    background-color: var(--ao-bg-4);
    border-color: var(--ao-line-hi);
}

.ao-dropdown-menu--open > .ao-dropdown-menu__button {
    border-color: var(--ao-line-focus);
}

.ao-dropdown-menu__caret {
    margin-left: 5px;
}

.ao-dropdown-menu__popup {
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Verdana/verdana-13.pixelfont");
    font-size: 13px;
    -unity-text-generator: standard;
    background-color: var(--ao-bg-2);
    border-width: 1px;
    border-color: var(--ao-line-hi);
}

.ao-dropdown-menu__entry {
    height: 20px;
    margin: 0;
    padding: 0 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: var(--ao-fg);
    -unity-text-align: middle-left;
}

.ao-dropdown-menu__entry:hover {
    background-color: var(--ao-bg-4);
    color: var(--ao-fg-hi);
}

.ao-dropdown-menu__entry.ao-dropdown-menu__entry--selected {
    color: var(--ao-fg-hi);
}

/* ─── Dock windows ─────────────────────────────────────────────────────── */

/* A tabbed window: the close button and the tab bar across the top, the
   selected view below. The tabs sit on the frame's top edge. Tab and drag
   image selectors carry two classes to outrank `.ao-view .unity-label`,
   which zeroes every label's padding. */
.ao-dock-window {
    background-color: var(--ao-window);
    border-width: 1px;
    border-color: var(--ao-line);
    color: var(--ao-fg);
}

.ao-dock-window__header {
    height: 18px;
    /* 2px on the right, as the 13px buttons have above and below them. None
       on the left: the tab's own padding puts the title 5px in, as much as
       the capitals have above them. */
    padding: 0 2px 0 0;
    border-bottom-width: 1px;
    border-color: var(--ao-line);
}

.ao-dock-window__accessory {
    margin: 0 3px 0 6px;
}

/* The header's buttons are small framed squares, 13px as stock's are: the
   close button with its drawn X, and a header dropdown with only its caret
   (the list shows which choice is picked). */
.ao-dock-window__close,
.ao-dock-window__accessory .ao-dropdown-menu__button {
    width: 13px;
    height: 13px;
    margin: 0;
    padding: 0;
    align-self: center;
    justify-content: center;
    align-items: center;
    background-color: var(--ao-bg-3);
    border-width: 1px;
    border-radius: 0;
    border-color: var(--ao-line);
    color: var(--ao-fg);
}

.ao-dock-window__close:hover,
.ao-dock-window__accessory .ao-dropdown-menu__button:hover {
    background-color: var(--ao-bg-4);
    border-color: var(--ao-line-hi);
    color: var(--ao-fg-hi);
}

.ao-dock-window__accessory .ao-dropdown-menu__label {
    display: none;
}

.ao-dock-window__accessory .ao-dropdown-menu__caret {
    margin: 0;
}

.ao-dock-window__tabs > .ao-dock-window__tab {
    height: 16px;
    /* The 2px at the bottom centres the pixel font's letters on the header
       buttons: measured, they otherwise sit 1px low. */
    padding: 0 8px 2px 4px;
    color: var(--ao-fg-dim);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ao-dock-window__tabs > .ao-dock-window__tab:hover {
    color: var(--ao-fg);
}

/* Tabs are plain text: the selected one is the bright one. */
.ao-dock-window__tabs > .ao-dock-window__tab.ao-dock-window__tab--selected {
    color: var(--ao-fg);
}

/* The view fills the window edge to edge, as stock's does: no padding, and a
   list inside drops its own frame, so the window's is the only one. */
.ao-dock-window__body {
    padding: 0;
}

.ao-dock-window__body .ao-multi-list-view {
    border-width: 0;
}

/* The resize edges (every side and corner) are invisible
   5px bands along the frame; the view decides whether and how it resizes. */

/* The tab's label following the pointer while it is dragged. */
.ao-view > .ao-dock-drag-image {
    height: 20px;
    padding: 0 10px;
    border-width: 1px;
    border-color: var(--ao-line-focus);
    background-color: var(--ao-bg-4);
    color: var(--ao-fg);
    -unity-text-align: middle-left;
}

/* ─── Scroll view ──────────────────────────────────────────────────────── */

/* 8px bars, flat track, a thumb with a 1px edge, and no arrow buttons. */
.ao-scroll-view .unity-scroller--vertical {
    width: 8px;
}

.ao-scroll-view .unity-scroller--horizontal {
    height: 8px;
}

.ao-scroll-view .unity-scroller__low-button,
.ao-scroll-view .unity-scroller__high-button {
    display: none;
}

.ao-scroll-view .unity-scroller > .unity-scroller__slider {
    margin: 0;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.ao-scroll-view .unity-scroller--vertical > .unity-scroller__slider {
    width: 8px;
}

.ao-scroll-view .unity-scroller--horizontal > .unity-scroller__slider {
    height: 8px;
}

.ao-scroll-view .unity-scroller__slider .unity-base-slider__input,
.ao-scroll-view .unity-scroller__slider .unity-base-slider__drag-container {
    margin: 0;
    padding: 0;
    min-width: 0;
    min-height: 0;
}

.ao-scroll-view .unity-base-slider__tracker {
    margin: 0;
    background-color: var(--ao-bg-0);
    border-width: 0;
    border-radius: 0;
}

.ao-scroll-view .unity-base-slider__dragger {
    margin: 0;
    background-color: var(--ao-bg-4);
    border-width: 1px;
    border-radius: 0;
    border-color: var(--ao-line);
}

/* In a grid the vertical bar lies over the grid's right margin instead of
   taking width from it, so the grid never loses a column when it starts to
   scroll. The last column leaves 4px of margin (its box's spacing and the
   grid's inset) beside its slot, which is the bar's width. */
.ao-multi-list-view--grid .ao-scroll-view .unity-scroller--vertical {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 4px;
}

.ao-multi-list-view--grid .ao-scroll-view .unity-scroller--vertical > .unity-scroller__slider,
.ao-multi-list-view--grid .ao-scroll-view .unity-scroller--vertical .unity-base-slider__tracker,
.ao-multi-list-view--grid .ao-scroll-view .unity-scroller--vertical .unity-base-slider__dragger {
    width: 4px;
}

/* Hover and drag states. The default theme restyles the track and the thumb
   while the whole slider is hovered or pressed (the thumb near-white), with
   rules more specific than one class and a pseudo, so these name the slider
   too to outrank them. */
.ao-scroll-view .unity-scroller .unity-base-slider:hover .unity-base-slider__tracker,
.ao-scroll-view .unity-scroller .unity-base-slider:active .unity-base-slider__tracker {
    background-color: var(--ao-bg-0);
    border-width: 0;
}

.ao-scroll-view .unity-scroller .unity-base-slider:hover .unity-base-slider__dragger {
    background-color: var(--ao-bg-4);
    border-width: 1px;
    border-color: var(--ao-line-hi);
}

.ao-scroll-view .unity-scroller .unity-base-slider .unity-base-slider__dragger:hover,
.ao-scroll-view .unity-scroller .unity-base-slider:active .unity-base-slider__dragger {
    background-color: var(--ao-line);
    border-width: 1px;
    border-color: var(--ao-line-focus);
}

.ao-scroll-view .unity-scroller--vertical .unity-base-slider__tracker,
.ao-scroll-view .unity-scroller--vertical .unity-base-slider__dragger {
    left: 0;
    width: 8px;
}

.ao-scroll-view .unity-scroller--horizontal .unity-base-slider__tracker,
.ao-scroll-view .unity-scroller--horizontal .unity-base-slider__dragger {
    top: 0;
    height: 8px;
}

.ao-scroll-view .unity-base-slider__dragger-border {
    display: none;
}

/* ─── Multi-column list ────────────────────────────────────────────────── */

.ao-multi-list-view {
    background-color: var(--ao-panel);
    border-width: 1px;
    border-color: var(--ao-line);
}

.ao-multi-list-view__header {
    height: 20px;
    background-color: var(--ao-bg-3);
    border-bottom-width: 1px;
    border-color: var(--ao-line);
}

.ao-column-header-view {
    align-items: center;
    padding: 0 8px;
    border-right-width: 1px;
    border-color: var(--ao-line);
    color: var(--ao-fg-dim);
}

.ao-column-header-view__label {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.ao-column-header-view:hover {
    background-color: var(--ao-bg-4);
    color: var(--ao-fg);
}

.ao-column-header-view.ao-column-header-view--sorted {
    color: var(--ao-accent);
}

.ao-column-header-view__caret {
    margin-left: 4px;
}

.ao-multi-list-view-item {
    justify-content: center;
    min-height: 20px;
    border-bottom-width: 1px;
    border-color: var(--ao-line);
    color: var(--ao-fg);
}

.ao-multi-list-view-item__row {
    align-items: center;
}

.ao-multi-list-view-item:hover {
    background-color: var(--ao-bg-3);
}

.ao-multi-list-view-item.ao-multi-list-view-item--selected {
    background-color: var(--ao-bg-4);
    color: var(--ao-fg-hi);
}

/* In the grid an item is a fixed box one pitch across (58px: the 48px cell
   and the 10px spacing). The box itself stays bare; the slot inside it is
   what gets framed. */
.ao-multi-list-view-item.ao-multi-list-view-item--grid {
    min-height: 0;
    border-width: 0;
}

.ao-multi-list-view-item.ao-multi-list-view-item--grid:hover,
.ao-multi-list-view-item.ao-multi-list-view-item--grid.ao-multi-list-view-item--selected {
    background-color: rgba(0, 0, 0, 0);
}

/* A slot, filled or empty. Stock's 58px pitch less the 2px margin each way
   leaves 4px between frames and 52px inside the 1px frame, so the 48px icon
   is never scaled. The slot draws its own frame, each
   corner cut by one crisp pixel (border-radius would blur it):
     --ao-slot-fill     the inside
     --ao-slot-line     the outline; its thickness is the border-width */
.ao-multi-list-view__slot {
    margin: 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    --ao-slot-fill: var(--ao-bg-2);
    --ao-slot-line: var(--ao-line);
}

.ao-multi-list-view-item--grid:hover > .ao-multi-list-view__slot {
    --ao-slot-line: var(--ao-line-hi);
}

.ao-multi-list-view-item--grid.ao-multi-list-view-item--selected > .ao-multi-list-view__slot {
    --ao-slot-line: var(--ao-line-focus);
}

.ao-multi-list-view-item__cell {
    padding: 0 8px;
    overflow: hidden;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
}

/* ─── Items ────────────────────────────────────────────────────────────── */

/* The Icon column is 16px wide and shows the whole icon in it. */
.ao-multi-list-view-item__cell.ao-inventory-list-view-item__icon {
    height: 16px;
    padding: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* 50px: stock icon art is 48x48 and must land on 48 whole pixels to stay sharp,
   so the slot is the icon plus its 1px border on each side. */
.ao-item-slot-view {
    width: 50px;
    height: 50px;
    margin: 0 4px 4px 0;
    background-color: var(--ao-bg-0);
    border-width: 1px;
    border-color: var(--ao-line);
}

.ao-item-slot-view:hover {
    border-color: var(--ao-line-hi);
}

.ao-item-slot-view.ao-item-slot-view--empty {
    border-color: var(--ao-line-lo);
}

.ao-item-icon-view {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: flex-end;
}

.ao-item-icon-view__stack {
    margin: 0 2px 1px 0;
    color: var(--ao-info);
}
