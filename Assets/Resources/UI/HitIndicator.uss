.hit-track {
    position: absolute;
    left: 0;
    top: 0;
    flex-grow: 0;
}

.hit-label {
    translate: -50% -100%;
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    margin: 0;
    padding: 0;
}
