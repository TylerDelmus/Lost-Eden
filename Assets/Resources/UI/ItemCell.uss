.item-cell {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    margin: 2px;
    padding: 2px;
    background-color: rgba(20, 22, 28, 0.85);
    border-width: 1px;
    border-color: rgb(90, 85, 70);
    border-radius: 2px;
    align-items: center;
    justify-content: center;
}

.item-cell-icon {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}
