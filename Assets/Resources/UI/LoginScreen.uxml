<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/LoginScreen.uss?fileID=7433441132597879392&amp;guid=94b031093aa7941449364315d54e2a18&amp;type=3#LoginScreen"/>

    <!-- Built from the Ao* widget classes ported from GUI.dll. Stock's LoginWindow.xml covers
         the username/password/buttons; the AO-path step and the dimension picker are ours,
         since the real client ships in place and picks its dimension elsewhere. The panels
         are AoBorderViews so the skin frames them; LoginScreen.uss only lays them out. -->
    <AoView name="root" class="login-root" view_layout="vertical">

        <AoBorderView name="aopath-panel" class="panel aopath-panel" view_layout="vertical">
            <AoView name="aopath-content" class="login-content" view_layout="vertical">
                <AoTextView value="Locate Anarchy Online" font="HUGE" class="title"/>
                <AoTextView value="Select your Anarchy Online installation folder." class="field-label"/>
                <AoTextInputView name="aopath-field" class="text-field"/>
                <AoButton name="browse-button" label="Browse..." class="browse-button"/>
                <AoSpacer/>
                <AoTextView name="aopath-status-text" value="" class="status-text"/>
            </AoView>
            <AoButton name="aopath-confirm-button" label="Continue" class="connect-button"/>
        </AoBorderView>

        <AoBorderView name="login-panel" class="panel login-panel" view_layout="vertical">
            <AoView name="login-content" class="login-content" view_layout="vertical">
                <AoTextView value="Username" class="field-label"/>
                <AoComboBox name="username-field" class="text-field"/>
                <AoTextView value="Password" class="field-label"/>
                <AoTextInputView name="password-field" class="text-field"/>
                <AoTextView value="Dimension" class="field-label"/>
                <AoComboBox name="dimension-dropdown" class="dropdown-field"/>
                <AoSpacer/>
                <AoTextView name="status-text" value="" class="status-text"/>
            </AoView>
            <AoButton name="connect-button" label="Login" class="connect-button"/>
        </AoBorderView>

        <AoBorderView name="character-panel" class="panel character-panel" view_layout="vertical">
            <AoView name="character-content" class="character-content" view_layout="vertical">
                <AoTextView value="Select Character" font="HUGE" class="title"/>
                <AoScrollView name="character-scroll" class="character-scroll" v_scrollbar_mode="auto">
                    <AoScrollViewChild name="character-list" class="character-list" view_layout="vertical"/>
                </AoScrollView>
                <AoTextView name="character-status-text" value="" class="status-text"/>
            </AoView>
            <AoButton name="back-button" label="Back" class="back-button"/>
        </AoBorderView>

    </AoView>
</ui:UXML>
