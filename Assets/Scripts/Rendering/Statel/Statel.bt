//------------------------------------------------
// 010 Editor Binary Template
// Anarchy Online playfield statel file (*.pf)
// Matches Assets/Scripts/Rendering/Statel/StatelParser.cs
//
// Layout:
//   int32 Version
//   int32 Offsets[]          // strictly increasing absolute file offsets
//   FIRST_BLOCK              // immediately after offset table
//                            // (rewound 4 bytes: FirstBlockLength was the
//                            //  int that broke the strictly-increasing loop)
//   STATEL_SET at Offsets[1], Offsets[2], ...
//------------------------------------------------
LittleEndian();

//------------------------------------------------
// Helpers
//------------------------------------------------

typedef struct {
    float X, Y, Z;
} VECTOR3 <read=Vector3Read>;

string Vector3Read(VECTOR3 &v) {
    string s;
    SPrintf(s, "(%.3f, %.3f, %.3f)", v.X, v.Y, v.Z);
    return s;
}

//------------------------------------------------
// Building entries (ParseBuilding)
//------------------------------------------------
// Position + Flags + MeshId + Flags2, then always:
//   Byte6, and if Byte6 > 0:
//     uint32 SubmeshMask   // bit N set => submesh N replaced
//     int32  TextureIds[Byte6]
//     if ((SubmeshMask & 0x7F0000) == 0x7F0000) : one extra int32 after TextureIds
// MeshId > 300000 entries use the same trailer but are skipped
// as placements (not Statels).

typedef struct {
    VECTOR3 Position;
    int32   Flags;
    uint32  MeshId;
    ubyte   Flags2;
    ubyte   Byte6;
    if (Byte6 > 0) {
        uint32 SubmeshMask;
        local uint texCount = Byte6 + ((SubmeshMask & 0x7F0000) == 0x7F0000 ? 1 : 0);
        int32  TextureIds[texCount];
    }
} BUILDING <read=BuildingRead>;

string BuildingRead(BUILDING &b) {
    string s;
    if (b.MeshId > 300000)
        SPrintf(s, "LARGE mesh=%u  flags=0x%X", b.MeshId, b.Flags);
    else
        SPrintf(s, "Statel mesh=%u  flags=0x%X  flags2=%u", b.MeshId, b.Flags, b.Flags2);
    return s;
}

typedef struct {
    uint16 Count;
    BUILDING Buildings[Count] <optimize=false>;
} BUILDING_BLOCK <read=BuildingBlockRead>;

string BuildingBlockRead(BUILDING_BLOCK &b) {
    string s;
    SPrintf(s, "%u buildings", b.Count);
    return s;
}

//------------------------------------------------
// Short buildings (ParseShortBuilding) — first block only
//------------------------------------------------

typedef struct {
    VECTOR3 Position;
    ubyte   Unk[5];
    ubyte   Byte6;
    // Same trailer size as BUILDING overrides
    if (Byte6 > 0) {
        uint32 UnkMask;
        local uint unkCount = Byte6 + ((UnkMask & 0x7F0000) == 0x7F0000 ? 1 : 0);
        int32  UnkInts[unkCount];
    }
} SHORT_BUILDING;

typedef struct {
    uint16 Count;
    SHORT_BUILDING Buildings[Count] <optimize=false>;
} SHORT_BUILDING_BLOCK <read=ShortBuildingBlockRead>;

string ShortBuildingBlockRead(SHORT_BUILDING_BLOCK &b) {
    string s;
    SPrintf(s, "%u short buildings", b.Count);
    return s;
}

//------------------------------------------------
// First block (ParseFirstBlock)
//------------------------------------------------
// reader.ReadInt32(); // BlockLength
// ParseBuilding(reader, placements);
// ParseShortBuilding(reader);

typedef struct {
    int32 FirstBlockLength;
    BUILDING_BLOCK Building;
    SHORT_BUILDING_BLOCK ShortBuilding;
} FIRST_BLOCK;

//------------------------------------------------
// Sector / set (ParseSet) — at Offsets[1..]
//------------------------------------------------
// ExtraShortCount + ExtraShorts[], then 5x ParseBuilding

typedef struct {
    uint16 ExtraShortCount;
    if (ExtraShortCount > 0)
        uint16 ExtraShorts[ExtraShortCount];
    BUILDING_BLOCK Buildings[5] <optimize=false>;
} STATEL_SET <read=StatelSetRead>;

string StatelSetRead(STATEL_SET &s) {
    string t;
    SPrintf(t, "extras=%u", s.ExtraShortCount);
    return t;
}

//------------------------------------------------
// Root
//------------------------------------------------

typedef struct {
    int32 Version;

    // Collect strictly increasing offsets. The next int32 that does not
    // increase becomes FirstBlock.FirstBlockLength (C# rewinds 4 bytes).
    local int offsetCount = 0;
    local int lastOffset = -1;
    local int nextOffset;

    while (FTell() + 4 <= FileSize()) {
        nextOffset = ReadInt(FTell());
        if (offsetCount > 0 && nextOffset <= lastOffset)
            break;
        lastOffset = nextOffset;
        offsetCount++;
        FSeek(FTell() + 4);
    }

    FSeek(sizeof(Version));
    int32 Offsets[offsetCount];

    FIRST_BLOCK FirstBlock;

    // ParseSet is only called for Offsets[1..] (index 0 is skipped).
    // C# also skips Offsets[count-1] via a len check; the template still
    // parses it so the last sector is visible in 010.
    local int i;
    local int setCount = (offsetCount > 1) ? (offsetCount - 1) : 0;
    local int setStart;

    for (i = 0; i < setCount; i++) {
        setStart = Offsets[i + 1];
        if (setStart < 0 || setStart >= FileSize())
            break;
        FSeek(setStart);
        STATEL_SET Set;
    }
} STATEL_FILE;

STATEL_FILE StatelFile <open=true>;
