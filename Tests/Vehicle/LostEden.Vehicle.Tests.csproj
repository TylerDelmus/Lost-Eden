    <Compile Include="..\..\Assets\Scripts\Vehicle\VehicleSim.cs" Link="VehicleSim.cs" />
    <Compile Include="..\..\Assets\Scripts\Vehicle\CameraVehicleSim.cs" Link="CameraVehicleSim.cs" />
